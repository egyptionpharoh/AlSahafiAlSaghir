# ============================================================
#  إعدادات «الصحفي الصغير»
#  انسخ هذا الملف باسم .env ثم عدّل القيم. لا ترفع ملف .env إلى أي مكان عام.
# ============================================================

# development للتجربة على جهازك — production على الاستضافة
NODE_ENV=development

# المنفذ الذي يعمل عليه التطبيق (الاستضافات عادة تضبطه تلقائيًا)
PORT=3000

# في الإنتاج اتركه 0.0.0.0، وعلى جهازك 127.0.0.1
# HOST=127.0.0.1

# عنوان الجريدة الكامل بعد النشر (يُستخدم في روابط المشاركة وبطاقات الدخول)
# مثال: https://sahafi.example.om
BASE_URL=

# سر عشوائي طويل (32 حرفًا على الأقل) — إلزامي في الإنتاج.
# لتوليده:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# مجلد البيانات الدائم: قاعدة البيانات app.db + مجلد الصور uploads
# في الاستضافة يجب أن يشير إلى «قرص دائم» (Persistent Disk / Volume) وإلا ضاعت البيانات.
DATA_DIR=./data

# (اختياري) مجلد صور مستقل عن مجلد البيانات
# UPLOADS_DIR=./data/uploads

# مجلد النسخ الاحتياطية
BACKUPS_DIR=./backups

# اجعله 1 إذا كان التطبيق خلف خادم وسيط (Nginx / Caddy / Render / Railway)
TRUST_PROXY=0

# الكوكي الآمن (Secure) — يُفعَّل تلقائيًا في الإنتاج. اجعله 0 فقط إن لم يكن لديك HTTPS (غير مستحسن)
# COOKIE_SECURE=1

# الحد الأقصى لحجم الصورة المرفوعة بالميغابايت (الصور تُضغط في المتصفح قبل الرفع)
MAX_UPLOAD_MB=6

# مدة الجلسة: تنتهي بعد 12 ساعة بلا نشاط، وبحد أقصى 7 أيام
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# 1 = تحميل الخطوط العربية من Google Fonts. 0 = خطوط الجهاز فقط (راجع README لاستضافة الخطوط ذاتيًا)
FONTS_CDN=1
